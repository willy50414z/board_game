# ---------------------------------------------------------------------------
# .env.sample — 複製成 .env 再填值：cp .env.sample .env
#
#   .env 已被 .gitignore 排除（/.env），金鑰不要進版控。
#   載入者：llm_provider.load_env()（自己寫的極簡解析器，不依賴 python-dotenv）。
#   語法：KEY=value，每行一組；# 開頭是註解；不要把註解寫在值後面。
#   優先序：shell 環境變數 > 本檔（load_env 用 setdefault，已 export 的不會被蓋）。
#
# 三家後端都走 OpenAI 相容端點，只需要下面三組；用不到的組留空即可。
# provider=auto 的規則：有 AZURE_OPENAI_ENDPOINT +（AZURE_OPENAI_API_KEY 或 AZURE_API_KEY）
#                       就選 gpt，否則退回 ollama。
# 自我檢查：python llm_provider.py --provider gpt -p "你是誰"
# ---------------------------------------------------------------------------

# ===== [1] Azure AI Foundry／GPT（--provider gpt）=====
# OpenAI 相容端點。給 ...openai.azure.com/openai/v1 最清楚；
# 只給根位址時 normalize_base_url() 會自動補 /openai/v1。
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
# 送進模型的模型名（CLI --model 可覆寫）。
AZURE_MODEL=gpt-6-luna
# 選填：不設就沿用 [2] 的 AZURE_API_KEY（兩套資源同一把 key 時不必重複貼）。
AZURE_OPENAI_API_KEY=

# ===== [2] Azure Document Intelligence OCR（--ocr azure）=====
# 只在 --ocr azure 時需要；預設 --ocr paddle 完全不用雲端服務。
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
# Document Intelligence 金鑰；同時也是 [1] 沒設 AZURE_OPENAI_API_KEY 時的 fallback。
AZURE_API_KEY=

# ===== [3] Ollama（--provider ollama，離線可用）=====
# 給根位址即可，程式自動補 /v1（CLI --host 可覆寫）。
OLLAMA_HOST=http://127.0.0.1:11434
# 必須是本機真的存在的 tag，先確認：curl http://127.0.0.1:11434/api/tags
OLLAMA_MODEL=qwen3-vl:8b-instruct
# Ollama 預設不驗金鑰，佔位即可（要驗就填 OLLAMA 那端的 key）。
OLLAMA_API_KEY=ollama

# ===== [4] 留檔相容 =====
# 目前沒有程式讀它（舊版腳本用過）。不需要就整行刪除。
AZURE_ENDPOINT=

# 備註：PaddleOCR 的 oneDNN／PIR 相容開關（PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT）
# 由 mannual_parser.run_ocr() 在 import 前自動設定，不需要放進 .env。
